---
import '../styles/global.css';

const projects = [
  {
    number: '01',
    category: 'Health Analytics · Inteligência Territorial · BI em Saúde Pública',
    title: 'UBS + IBGE + Cobertura Potencial APS',
    context: 'O planejamento da Atenção Primária não depende apenas de contar unidades de saúde. É preciso entender onde a rede está, qual população ela atende, como o território pressiona a operação e onde há diferenças entre presença física e capacidade instalada.',
    objective: 'Integrar dados de UBS, indicadores territoriais do IBGE/SIDRA e Cobertura Potencial da APS para construir uma leitura nacional da rede básica de saúde e apoiar decisões de planejamento territorial.',
    results: 'O projeto consolidou 47.714 registros de UBS, 5.483 municípios, população APS superior a 210 milhões e capacidade estimada acima de 180 milhões. O painel compara distribuição territorial, cobertura, qualidade de coordenadas e pressão populacional.',
    tools: ['Python', 'Pandas', 'IBGE/SIDRA', 'Data Quality', 'Health Analytics', 'Dashboard'],
    metrics: ['47.714 UBS', '5.483 municípios', '210,4M população APS'],
    github: 'https://github.com/luandarodrigues/ubs-aps-territorial-intelligence',
    dashboard: 'https://luandarodrigues.github.io/luandarodrigues/dashboards/ubs-healthcare-mapping/'
  },
  {
    number: '02',
    category: 'Machine Learning · Risco Clínico · Responsible ML',
    title: 'Heart Disease Risk Prediction',
    context: 'Bases clínicas podem apoiar a investigação de risco cardiovascular, mas precisam ser analisadas com cuidado. Boa performance estatística não significa prontidão clínica sem validação, calibração e governança.',
    objective: 'Construir e avaliar modelos de classificação para prever presença de doença cardíaca, traduzindo as variáveis técnicas para significado clínico e discutindo limites de uso responsável.',
    results: 'O painel compara Logistic Regression e Random Forest, com ROC-AUC próximo de 0,93. A análise destaca ST_Slope, ChestPainType, ExerciseAngina, Oldpeak e outras variáveis como sinais relevantes dentro da base.',
    tools: ['Python', 'Pandas', 'Scikit-learn', 'Machine Learning', 'Permutation Importance', 'Clinical Dictionary'],
    metrics: ['918 registros', '11 preditores', 'ROC-AUC ≈ 0,93'],
    github: 'https://github.com/luandarodrigues/heart-disease-risk-prediction',
    dashboard: 'https://luandarodrigues.github.io/heart-disease-risk-prediction/'
  },
  {
    number: '03',
    category: 'Marketplace Analytics · SQL Mart · CX Risk · Storytelling',
    title: 'Olist Delivery Experience Analytics',
    context: 'Em marketplaces, a avaliação do cliente muitas vezes é o reflexo final da operação. Atraso, frete, rota, categoria e estrutura do pedido influenciam a experiência depois da compra.',
    objective: 'Transformar os CSVs brutos da Olist em uma camada analítica por pedido, testar hipóteses de negócio e criar um painel narrativo sobre risco de baixa avaliação e performance logística.',
    results: 'O projeto analisa 99.441 pedidos, 96.478 entregues e R$ 15,8M em GMV. O painel mostra que entregas entre estados têm maior tempo e frete, e que algumas categorias combinam escala com maior exposição a reviews baixos.',
    tools: ['Python', 'Pandas', 'SQL', 'Git LFS', 'KaggleHub', 'Scikit-learn', 'Storytelling Dashboard'],
    metrics: ['99.441 pedidos', 'R$ 15,8M GMV', 'PT/EN dashboard'],
    github: 'https://github.com/luandarodrigues/olist-delivery-experience-analytics',
    dashboard: 'https://luandarodrigues.github.io/olist-delivery-experience-analytics/'
  },
  {
    number: '04',
    category: 'Graph Analytics · NLP · Sistemas de Recomendação',
    title: 'CineGraph Network Intelligence',
    context: 'Dados de filmes, pessoas, relações de elenco, recomendações e textos de reviews podem ser analisados como uma rede. Isso permite estudar conexão, cobertura, similaridade e recomendação de conteúdo.',
    objective: 'Explorar um dataset amplo de mídia com técnicas de grafos e NLP para mapear relações entre filmes, pessoas, recomendações, streaming e sinais textuais.',
    results: 'O projeto trabalha com 22.393 filmes, 58.393 pessoas e relações entre títulos, elenco e recomendações. A análise estrutura o problema como inteligência de rede aplicada a conteúdo audiovisual.',
    tools: ['Python', 'Pandas', 'NetworkX', 'Graph Analytics', 'NLP', 'Recommendation Systems'],
    metrics: ['22.393 filmes', '58.393 pessoas', 'Graph + NLP'],
    github: 'https://github.com/luandarodrigues/cinegraph-network-intelligence',
    dashboard: ''
  }
];

const notebookReports = [
  {
    theme: 'Farmacovigilância bayesiana',
    title: 'GLP-1 Bayesian Pharmacovigilance',
    result: 'Com openFDA/FAERS, o estudo compara Semaglutide e Tirzepatide por um modelo Beta-Binomial. O foco não é causalidade clínica, e sim um sinal estatístico honesto sobre serious reports e viés de notificação.',
    methods: ['openFDA/FAERS', 'Beta-Binomial', 'Posterior intervals'],
    link: 'https://github.com/luandarodrigues/projectsforjupyternotebook/tree/main/notebooks/glp1-bayesian-farmacovigilancia'
  },
  {
    theme: 'Inferência causal',
    title: 'Remote Work Salary Premium',
    result: 'O gap bruto de salário remoto cai depois dos ajustes: AIPW estimou prêmio médio de 2,4%, com intervalo de -8,2% a 14,2%. A leitura principal é sobre seleção, confundimento e incerteza.',
    methods: ['AIPW', 'DML', 'Propensity score'],
    link: 'https://github.com/luandarodrigues/projectsforjupyternotebook/tree/main/notebooks/remote-work-salary-causal-inference'
  },
  {
    theme: 'Séries financeiras',
    title: 'Crypto Market Regime Detection',
    result: 'Usando dados recentes da Binance, o notebook separa regimes de BTC/ETH com mistura gaussiana, validação por BIC e teste fora da amostra. O report discute estabilidade, drawdown e mudança de volatilidade.',
    methods: ['Binance API', 'GMM', 'BIC + train/test'],
    link: 'https://github.com/luandarodrigues/projectsforjupyternotebook/tree/main/notebooks/crypto-market-regime-detection'
  },
  {
    theme: 'Macroeconomia aplicada',
    title: 'Brazil Inflation & Monetary Regimes',
    result: 'Com séries BCB/SGS entre 2002 e 2026, o projeto encontra 4 regimes por BIC e lê inflação, Selic, câmbio e juros reais junto com base bibliográfica sobre pass-through e inflation targeting.',
    methods: ['BCB/SGS', 'GMM', 'Literature review'],
    link: 'https://github.com/luandarodrigues/projectsforjupyternotebook/tree/main/notebooks/brazil-inflation-monetary-regimes'
  }
];

const skills = [
  'Python', 'SQL', 'Pandas', 'Scikit-learn', 'Power BI', 'Looker', 'Excel',
  'Machine Learning', 'Graph Analytics', 'NLP', 'NetworkX', 'Data Quality',
  'Health Analytics', 'Marketplace Analytics', 'Macroeconomics', 'Causal Inference',
  'KPI Design', 'Operations Analytics', 'Customer Experience', 'Notebook Reports',
  'Storytelling Dashboards', 'Git', 'GitHub Pages'
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Luanda Rodrigues — portfólio de Data Analytics, BI, estatística aplicada, machine learning, SQL, grafos, NLP e reports em notebooks." />
    <title>Luanda Rodrigues — Data Analyst</title>
  </head>
  <body>
    <main>
      <section class="hero">
        <nav class="nav" aria-label="Navegação principal">
          <a href="#projects">Projetos</a>
          <a href="#notebooks">Notebooks</a>
          <a href="#about">Sobre</a>
          <a href="#skills">Skills</a>
          <a href="#contact">Contato</a>
        </nav>

        <div class="hero-grid">
          <div class="hero-copy">
            <div class="eyebrow">Data / Statistics / ML / BI</div>
            <h1>Luanda Rodrigues</h1>
            <p class="hero-subtitle">Analista de dados que transforma base crua em diagnóstico, modelo e história visual que alguém consegue usar.</p>
            <div class="hero-actions">
              <a class="button primary" href="https://github.com/luandarodrigues" target="_blank" rel="noreferrer">GitHub</a>
              <a class="button" href="https://www.linkedin.com/in/luanda-rodrigues" target="_blank" rel="noreferrer">LinkedIn</a>
              <a class="button" href="mailto:luandarodrigues30@gmail.com">Email</a>
            </div>
          </div>
          <figure class="hero-photo-card">
            <img src="/Segunda%20feira.jpg" alt="Foto titular de Luanda Rodrigues" />
          </figure>
        </div>
      </section>

      <section class="intro-grid" id="about">
        <div>
          <span class="section-label">Sobre</span>
          <h2>Dados com contexto, método e consequência.</h2>
        </div>
        <div class="intro-copy">
          <p>Trabalho na ponte entre dados, operação e decisão. Gosto de pegar uma base difícil, entender o que ela deixa escapar, limpar o suficiente para confiar e devolver uma leitura que ajude alguém a agir.</p>
          <p>Minha trajetória passa por saúde, farmácia clínica, BI, IA aplicada, dados públicos, machine learning, grafos, NLP e dashboards narrativos. No portfólio, tento deixar o raciocínio visível: fonte, método, resultado e limite.</p>
        </div>
      </section>

      <section id="projects" class="projects-section">
        <div class="section-header">
          <div>
            <span class="section-label">Meus trabalhos</span>
            <h2>Projetos públicos de portfólio</h2>
          </div>
          <p>Projetos maiores, com dashboard ou case completo. Alguns nasceram de dados públicos, outros de uma pergunta operacional que merecia virar produto analítico.</p>
        </div>

        <div class="projects-list">
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-number">{project.number}</div>
              <div class="project-content">
                <p class="project-type">{project.category}</p>
                <h3>{project.title}</h3>
                <div class="project-story">
                  <p><strong>Contexto:</strong> {project.context}</p>
                  <p><strong>Objetivo:</strong> {project.objective}</p>
                  <p><strong>Resultados:</strong> {project.results}</p>
                </div>
                <ul class="metrics-list">
                  {project.metrics.map((metric) => <li>{metric}</li>)}
                </ul>
                <div class="tools-line">
                  <strong>Ferramentas:</strong> {project.tools.join(' · ')}
                </div>
              </div>
              <div class="project-actions">
                <a class="project-link" href={project.github} target="_blank" rel="noreferrer">GitHub</a>
                {project.dashboard && <a class="project-link filled" href={project.dashboard} target="_blank" rel="noreferrer">Dashboard</a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="notebooks" class="notebooks-section">
        <div class="section-header">
          <div>
            <span class="section-label">Reports em notebooks</span>
            <h2>Análises com estatística, gráficos e resultado</h2>
          </div>
          <p>Notebooks escritos como pequenos reports: pergunta clara, dados recentes quando faz sentido, método explícito, figuras no README e uma conclusão que respeita a incerteza.</p>
        </div>

        <div class="notebook-grid">
          {notebookReports.map((report) => (
            <article class="notebook-card">
              <p class="notebook-theme">{report.theme}</p>
              <h3>{report.title}</h3>
              <p>{report.result}</p>
              <ul>
                {report.methods.map((method) => <li>{method}</li>)}
              </ul>
              <a class="notebook-link" href={report.link} target="_blank" rel="noreferrer">Abrir report no GitHub</a>
            </article>
          ))}
        </div>
      </section>

      <section id="skills" class="skills-section">
        <span class="section-label">Stack</span>
        <h2>Ferramentas e foco analítico</h2>
        <div class="skills-wrap">
          {skills.map((skill) => <span>{skill}</span>)}
        </div>
      </section>

      <section class="confidential-section">
        <div>
          <span class="section-label">Trabalhos aplicados</span>
          <h2>Projetos confidenciais em saúde e negócios</h2>
        </div>
        <div class="confidential-grid">
          <article>
            <h3>Clinical Pharmacy KPI Dashboard</h3>
            <p>Projeto institucional no contexto EBSERH / HC-UFU. A versão pública fica no nível das competências: desenho de KPIs, leitura de fluxos hospitalares e monitoramento operacional.</p>
          </article>
          <article>
            <h3>AI for Scientific Communication</h3>
            <p>Projetos privados em saúde com IA aplicada, automação, comunicação científica, estratégia de conteúdo e fluxos low-code.</p>
          </article>
          <article>
            <h3>Performance Dashboard for Decision-Making</h3>
            <p>Trabalho corporativo de BI com indicadores, relatórios executivos, dashboards e análise de negócio em ambientes fechados.</p>
          </article>
        </div>
      </section>

      <footer id="contact">
        <div>
          <span class="section-label">Contato</span>
          <h2>Aberta a oportunidades em dados, BI e analytics.</h2>
        </div>
        <div class="footer-links">
          <a href="mailto:luandarodrigues30@gmail.com">luandarodrigues30@gmail.com</a>
          <a href="https://github.com/luandarodrigues" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/luanda-rodrigues" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="https://www.behance.net/luandarodrguez" target="_blank" rel="noreferrer">Behance</a>
        </div>
      </footer>
    </main>
  </body>
</html>
